---
import { Image } from 'astro:assets';
import type { Visual } from '../data';
import ArcCockpit from './ArcCockpit.astro';
import SiemConsole from './SiemConsole.astro';
import '../styles/scenes.css';

// `still` renders the finished visual with no steps, as the case pages show it
const { visual, still = false } = Astro.props as { visual: Visual; still?: boolean };
const captions = still || visual.kind === 'phone' ? [] : visual.steps.map(s => s.caption);
const scene = captions.length > 0;
const steps = captions.length;
const pad = (n: number) => String(n).padStart(2, '0');
const Wrap = scene ? 'figure' : Fragment;
const wrap = scene ? { class: 'scene', 'data-steps': steps } : {};
---

<Wrap {...wrap}>
  <div class="project-visual">
    {visual.kind === 'console' ? (
      visual.product === 'siem' ? <SiemConsole visual={visual} scene={scene} /> : <ArcCockpit visual={visual} scene={scene} />
    ) : (
      <div class="phone">
        <Image src={visual.image} alt={visual.alt} widths={[230, 460, 690]} sizes="230px" />
      </div>
    )}
  </div>
  {scene && (
    <figcaption>
      <ol class="scene-captions">
        {captions.map((caption, i) => (
          <li data-at={i + 1}>
            <span class="scene-count">{`${pad(i + 1)} / ${pad(steps)}`}</span> <span>{caption}</span>
          </li>
        ))}
      </ol>
    </figcaption>
  )}
</Wrap>
