---
// the siem console, drawn after the hero of the product's website (apps/website HeroConsole.astro in the siem repo):
// the ACME demo tenant, its data the one invented attack the steps tell. with `scene` each panel and command carries
// the step it lights in; console.css plays them off the row's data-step
import type { SiemPanel, Visual } from '../data';
import ConsoleCommand from './ConsoleCommand.astro';
import '../styles/console.css';

type Props = { visual: Extract<Visual, { product: 'siem' }>; scene: boolean };
const { visual, scene } = Astro.props;

const at = (panel: SiemPanel) => (scene ? visual.steps.findIndex(s => s.panel === panel) + 1 : undefined);

// events over 24 hours in half-hour bars: quiet at night, one red bar in the small hours (the probes)
const HOT_BAR = 7;
const bars = Array.from({ length: 48 }, (_, i) => {
  const r = Math.abs(Math.sin(i * 12.9898) * 43758.5453) % 1;
  const v = i === HOT_BAR ? 0.95 : 0.12 + 0.62 * (0.5 + 0.5 * Math.sin(((i - 18) / 48) * Math.PI * 2)) + 0.16 * r;
  const h = Math.max(2, v * 44);
  return { x: (i * 7.08).toFixed(1), y: (46 - h).toFixed(1), h: h.toFixed(1), hot: i === HOT_BAR, delay: `${(i * 0.012).toFixed(3)}s` };
});
// the risk score and the detectors that built it
const RISK = 72;
const why = [['Off-hours', 28], ['One service', 24], ['One country', 20]] as const;
const iocs = [
  ['203.0.113.61', 'IP', 'Listed', 'bad'],
  ['login-check.example', 'Domain', 'Phishing', 'warn'],
  ['9f2c…a71e', 'Hash', 'Clean', 'ok'],
] as const;
const chainX = [30, 123, 216, 310];
const chainSteps = ['Night probes', 'Failed logins', 'j.doe login', 'VPN break-in'];
---

<div class="console" role="img" aria-label={visual.label}>
  <div class="db">
    <div class="db-bar">
      <svg width="14" height="14" viewBox="0 0 24 24"><path d="M12 2 22 12 12 22 2 12z" fill="#0e1118" stroke="rgb(169 212 255)" stroke-width="1.6" /><path d="M7 7 12 12 17 7M12 12v10" fill="none" stroke="rgb(76 141 255)" stroke-width="1.3" /></svg>
      <b>ACME</b><span class="db-mute">/ Overview</span>
      <span class="db-space"></span>
      <span class="db-search"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>Search events</span>
      <span class="db-chip">Last 24 hours</span>
      <span class="db-live"><i></i>Live</span>
    </div>
    <div class="db-grid">
      <section class="p" data-at={at('agent')}>
        <header><svg viewBox="0 0 24 24"><path d="M12 7V4.5M12 3.2h.01M7 7h10a3 3 0 0 1 3 3v6a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3v-6a3 3 0 0 1 3-3zM2 12v3M22 12v3M9 11.2v1.8M15 11.2v1.8M9.5 16h5" /></svg>Assistant</header>
        <p class="p-ask m-fade">Why was this raised?</p>
        <p class="p-answer m-fade" style="animation-delay: .45s">The same address that probed your VPN at night logged in as j.doe after 20 failed tries.</p>
      </section>
      <section class="p" data-at={at('risk')}>
        <header><svg viewBox="0 0 24 24"><path d="M3 12h4l3-8 4 16 3-8h4" /></svg>Risk score<span class="p-meta mono">203.0.113.61</span></header>
        <div class="p-risk">
          <div class="p-score"><b>{RISK}</b><span>Risk</span></div>
          <div class="p-why">
            {why.map(([name, add], k) => (
              <div><span>{name}</span><span class="p-track"><i class="m-grow" style={`width: ${Math.round((add / RISK) * 100)}%; animation-delay: ${k * 0.15}s`}></i></span><span class="mono">+{add}</span></div>
            ))}
          </div>
        </div>
      </section>
      <section class="p" data-at={at('intel')}>
        <header><svg viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 4.5-3.2 8-8 9-4.8-1-8-4.5-8-9V6zM9 12l2 2 4-4" /></svg>Indicators</header>
        <div class="p-iocs">
          {iocs.map(([value, type, verdict, tone], k) => (
            <div class="m-fade" style={`animation-delay: ${k * 0.15}s`}><span class="mono">{value}</span><span class="db-mute">{type}</span><span class={`tag tag-${tone}`}>{verdict}</span></div>
          ))}
        </div>
      </section>
      <section class="p" data-at={at('chain')}>
        <header><svg viewBox="0 0 24 24"><path d="M6 6a2 2 0 1 0 .01 0M18 6a2 2 0 1 0 .01 0M12 18a2 2 0 1 0 .01 0M7.7 7.5 11 16M16.3 7.5 13 16M8 6h8" /></svg>Attack chain</header>
        <svg class="p-chain" viewBox="0 0 340 66">
          {chainX.slice(1).map((x, k) => <path class="m-draw" pathLength="100" d={`M${chainX[k] + 6} 22H${x - 7}`} stroke={k === 2 ? 'var(--danger)' : 'var(--accent)'} style={`animation-delay: ${k * 0.3}s`} />)}
          {chainX.map((x, k) => (k < 3 ? <circle cx={x} cy="22" r="6" class="p-node" /> : <circle cx={x} cy="22" r="7" fill="var(--danger)" />))}
          {chainX.map((x, k) => <text x={x} y="50" text-anchor="middle" class={k === 3 ? 'p-last' : undefined}>{chainSteps[k]}</text>)}
        </svg>
      </section>
      <section class="p" data-at={at('alerts')}>
        <header><svg viewBox="0 0 24 24"><path d="M6 16v-5a6 6 0 1 1 12 0v5l2 2H4zM10 20h4" /></svg>Warnings<span class="p-meta">2 open</span></header>
        <div class="p-alert m-fade"><span class="tag tag-bad">High</span><span>Break-in on the VPN</span></div>
        <div class="p-alert m-fade" style="animation-delay: .2s"><span class="tag tag-warn">Medium</span><span>New admin on FIN-WS-014</span></div>
        <div class="p-chips"><span>Skipped:</span>{['Whitelist', 'Dedup', 'Suppression', 'Tuning'].map(f => <span class="p-chip">{f}</span>)}</div>
      </section>
      <section class="p" data-at={at('events')}>
        <header><svg viewBox="0 0 24 24"><path d="M4 4h7v9H4zM13 4h7v5h-7zM13 11h7v9h-7zM4 15h7v5H4z" /></svg>Events</header>
        <svg class="p-bars" viewBox="0 0 340 46" preserveAspectRatio="none">
          {bars.map(b => <rect class="m-rise" x={b.x} y={b.y} width="5" height={b.h} rx="1" fill={b.hot ? 'var(--danger)' : 'rgb(var(--accent-rgb) / .7)'} style={`animation-delay: ${b.delay}`} />)}
        </svg>
        <div class="p-chips">{['Firewall', 'AD', 'VPN', 'EDR'].map(s => <span class="p-src">{s}</span>)}<span>and more</span><span class="p-find"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>Search</span></div>
      </section>
    </div>
  </div>
  {scene && <ConsoleCommand steps={visual.steps} />}
</div>
