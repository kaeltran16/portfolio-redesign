---
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/500.css';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/global.css';

const name = 'Khang Tran';
const role = 'Full-stack';
const roles = ['Developer', 'Backend engineer', 'Frontend engineer', 'Tool builder'];
const rolesLabel = `${roles.slice(0, -1).join(', ')}, and ${roles.at(-1)}`;
const nav = ['Projects', 'Experience', 'About', 'Contact'];

// placeholders from the experience canvas until the real cv lands; the first entry is the current role
const experience = [
  {
    title: '[Current role]',
    company: '[Company A]',
    dates: '[2023] – now',
    highlights: ['[What you built or owned, and what it changed]', '[A second highlight, ideally with a number you can stand behind]', '[A third highlight]'],
  },
  {
    title: '[Previous role]',
    company: '[Company B]',
    dates: '[2021] – [2023]',
    highlights: ['[What you built or owned, and what it changed]', '[A second highlight]'],
  },
  {
    title: '[Earlier role]',
    company: '[Company C]',
    dates: '[2019] – [2021]',
    highlights: ['[What you built or owned, and what it changed]'],
  },
];

const social = [
  {
    label: 'GitHub',
    href: 'https://github.com/kaeltran16',
    path: 'M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z',
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/khangtranx',
    path: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45Z',
  },
  {
    label: 'Email',
    href: 'mailto:cktran16x2@gmail.com',
    path: 'M3 4.5h18A1.5 1.5 0 0 1 22.5 6v12a1.5 1.5 0 0 1-1.5 1.5H3A1.5 1.5 0 0 1 1.5 18V6A1.5 1.5 0 0 1 3 4.5Zm.5 3V17.5h17V7.5l-8.5 6-8.5-6Zm1.6-1 6.9 4.9 6.9-4.9H5.1Z',
  },
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{name} | Full-stack software developer</title>
    <meta name="description" content={`${name}, full-stack software developer. I build the tools engineers use.`} />
    <script is:inline>
      // set before first paint so there is no theme flash, and so no-js visitors get the final state
      document.documentElement.classList.add('js');
      const theme = localStorage.getItem('theme');
      if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
    </script>
  </head>
  <body>
    <header class="rail">
      <a class="monogram" href="#intro" aria-label={`${name}, ${role} developer`}>
        <svg aria-hidden="true" class="mark" width="48" height="29" viewBox="0 0 48 29">
          <text x="0" y="22">kt<tspan class="mark-cursor">_</tspan></text>
        </svg>
      </a>
      <nav class="rail-nav" aria-label="Main">
        <div class="rail-links">
          {nav.map(label => <a class="rail-link" href={`#${label.toLowerCase()}`}>{label}</a>)}
        </div>
        <div class="rail-icons">
          {
            social.map(({ label, href, path }) => (
              <a class="rail-icon" href={href} aria-label={label} target={href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">
                <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24"><path d={path} /></svg>
              </a>
            ))
          }
        </div>
      </nav>
    </header>

    <button class="theme-toggle" type="button" aria-label="Toggle theme" data-theme-toggle>
      <svg aria-hidden="true" width="38" height="38" viewBox="0 0 38 38">
        <defs>
          <mask id="theme-toggle-mask">
            <circle class="toggle-circle" data-mask="true" cx="19" cy="19" r="13"></circle>
            <circle class="toggle-mask" cx="25" cy="14" r="9"></circle>
          </mask>
        </defs>
        <path class="toggle-rays" d="M19 3v7M19 35v-7M32.856 11l-6.062 3.5M5.144 27l6.062-3.5M5.144 11l6.062 3.5M32.856 27l-6.062-3.5"></path>
        <circle class="toggle-circle" mask="url(#theme-toggle-mask)" cx="19" cy="19" r="12"></circle>
      </svg>
    </button>

    <main>
      <section class="intro" id="intro" aria-labelledby="intro-title">
        <canvas class="sphere" aria-hidden="true" data-sphere></canvas>

        <header class="intro-text">
          <h1 class="intro-name" id="intro-title" data-intro-name>
            <span class="visually-hidden">{name}</span>
            <span aria-hidden="true" data-decode>{name}</span>
          </h1>
          <h2 class="intro-title" data-title>
            <span class="visually-hidden">{`${role} + ${rolesLabel}`}</span>
            <span aria-hidden="true" class="intro-row">
              <span class="intro-word" data-stage style="--delay: 200ms">{role}</span>
              <span class="intro-line" data-stage></span>
            </span>
            <span aria-hidden="true" class="intro-row">
              {roles.map((r, i) => <span class="intro-word" data-plus data-role data-status={i === 0 ? 'entered' : ''} style="--delay: 600ms">{r}</span>)}
            </span>
            <span aria-hidden="true" class="intro-sizer" data-title-sizer>
              {roles.map(r => <span class="intro-word" data-plus>{r}</span>)}
            </span>
          </h2>
          <div class="intro-pitch" data-stage>
            <p>Full-stack software developer. I build the tools engineers use.</p>
            <a class="button" href="/cv.pdf" download="Khang-Tran-CV.pdf">
              <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24"><path d="M11 3h2v10.17l3.59-3.58L18 11l-6 6-6-6 1.41-1.41L11 13.17zM5 19h14v2H5z" /></svg>
              <span>Download CV</span>
            </a>
          </div>
        </header>

        <a class="scroll-cue" href="#projects" data-stage data-scroll-cue><span class="visually-hidden">Scroll to projects</span></a>
        <a class="scroll-cue-mobile" href="#projects" data-stage data-scroll-cue>
          <span class="visually-hidden">Scroll to projects</span>
          <svg aria-hidden="true" stroke="currentColor" width="43" height="15" viewBox="0 0 43 15"><path d="M1 1l20.5 12L42 1" stroke-width="2" fill="none" /></svg>
        </a>
      </section>

      <section class="next" id="projects">
        <p>Projects come next. This build is the first screen only.</p>
      </section>

      <section class="experience" id="experience" aria-labelledby="experience-title">
        <div class="experience-head">
          <h2 id="experience-title">Experience</h2>
          <a class="button" href="/cv.pdf" download="Khang-Tran-CV.pdf">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24"><path d="M11 3h2v10.17l3.59-3.58L18 11l-6 6-6-6 1.41-1.41L11 13.17zM5 19h14v2H5z" /></svg>
            <span>Download CV</span>
          </a>
        </div>
        <ol class="experience-list">
          {
            experience.map(({ title, company, dates, highlights }, i) => (
              <li class="experience-role" data-current={i === 0 ? 'true' : undefined}>
                <p class="experience-dates">{dates}</p>
                <div class="experience-marker" aria-hidden="true"></div>
                <div class="experience-body">
                  <h3>{title}</h3>
                  <p class="experience-company">{company}</p>
                  <ul>
                    {highlights.map(h => <li>{h}</li>)}
                  </ul>
                </div>
              </li>
            ))
          }
        </ol>
      </section>
    </main>


    <script>
      import '../scripts/page';
    </script>
  </body>
</html>
