    slug: 'expensepal',
    title: 'expensepal',
    description: '[expensepal: one line on what it does and who it is for]',
    visual: { kind: 'phone', placeholder: '[expensepal screenshot]' },
  },
  {
    // device type unknown; a phone until khang says otherwise
    slug: 'loom',
