---
import Base from '../layouts/Base.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import { name, projects, role, social } from '../data';

const roles = ['Developer', 'Backend engineer', 'Frontend engineer', 'Tool builder'];
const rolesLabel = `${roles.slice(0, -1).join(', ')}, and ${roles.at(-1)}`;

// copied from the cv (public/cv.pdf, built from job-search/resume_v2.md path b); keep the two in step.
// the first entry is the current role
const experience = [
  {
    title: 'Full-stack Engineer',
    company: 'MozoX',
    dates: 'Apr 2023 – now',
    highlights: [
      'Shipped production LLM features for a multi-tenant enterprise SIEM platform processing ~1,000 security events/sec: an AI log parser mapping arbitrary log sources to schema fields with no hand-written parser (new-source onboarding from ~7 days to minutes; ~20% of total log volume now parsed by the AI pipeline), natural-language-to-query search, and AI-generated multilingual executive reports.',
      'Built an AI correlation engine combining Isolation Forest, autoencoder, and Z-score models with automated MITRE ATT&CK mapping for real-time, multi-tenant threat detection.',
      'Built full-stack across the platform (Next.js/React, Java + Python, PostgreSQL + Elasticsearch); integrated 4+ security-vendor log sources (Check Point, F5, CrowdStrike, VMware ESXi) and MITRE ATT&CK analytics dashboards.',
      'Initiated and led a web-application modernization effort (dependency upgrades, tech-debt reduction) with zero disruption to the live system; built centralized cross-component system-log monitoring.',
      'Prototyped an IoT + LLM/RAG platform for durian cultivation: sensor-stream ingestion, ML harvest prediction, and natural-language queries over farm data; built and validated before the product line was discontinued.',
    ],
  },
  {
    title: 'Full-stack Engineer',
    company: 'CNG',
    dates: 'Mar 2022 – Apr 2023',
    highlights: [
      'Led a team of 3 to build a property-search web app (Next.js, Tailwind, Nest.js, Mapbox) letting users browse and buy properties on an interactive map.',
      'Implemented geospatial computation and vector-tile rendering to display property polygons on Mapbox.',
      "Translated business requirements into technical specs, decomposed them into components, and reviewed teammates' code across architecture, implementation, testing, and deployment.",
    ],
  },
];

const email = social.find(s => s.href.startsWith('mailto:'))!;
const elsewhere = social.filter(s => s !== email);

// draft copy until khang finalizes it
const about = [
  'I’m Khang, a full-stack engineer in Ho Chi Minh City. At MozoX I build a multi-tenant security platform, from the React panels analysts use to the Java and Python services behind them, and lately the LLM and ML features in between.',
  'I like owning a feature end to end, and I care most about the tools other engineers use. Outside work that means side projects like Arc, a cockpit for coding agents, and opal, an app I open every morning.',
  'If you are hiring, building something in this space, or just want to talk shop, my inbox is open.',
];
const contactPitch = 'Open to remote full-stack roles, and always happy to talk about developer tooling.';
---

<Base title={`${name} | Full-stack software developer`} description={`${name}, full-stack software developer. I build the tools engineers use.`}>
  <main>
    <section class="intro" id="intro" aria-labelledby="intro-title">
      <canvas class="sphere" aria-hidden="true" data-sphere></canvas>

      <header class="intro-text">
        <h1 class="intro-name" id="intro-title" data-intro-name>
          <span class="visually-hidden">{name}</span>
          <span aria-hidden="true" data-decode>{name}</span>
        </h1>
        <h2 class="intro-title" data-title>
          <span class="visually-hidden">{`${role} + ${rolesLabel}`}</span>
          <span aria-hidden="true" class="intro-row">
            <span class="intro-word" data-stage style="--delay: 200ms">{role}</span>
            <span class="intro-line" data-stage></span>
          </span>
          <span aria-hidden="true" class="intro-row">
            {roles.map((r, i) => <span class="intro-word" data-plus data-role data-status={i === 0 ? 'entered' : ''} style="--delay: 600ms">{r}</span>)}
          </span>
          <span aria-hidden="true" class="intro-sizer" data-title-sizer>
            {roles.map(r => <span class="intro-word" data-plus>{r}</span>)}
          </span>
        </h2>
        <div class="intro-pitch" data-stage>
          <p>Full-stack software developer. I build the tools engineers use.</p>
          <a class="button" href="/cv.pdf" download="Khang-Tran-CV.pdf">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24"><path d="M11 3h2v10.17l3.59-3.58L18 11l-6 6-6-6 1.41-1.41L11 13.17zM5 19h14v2H5z" /></svg>
            <span>Download CV</span>
          </a>
        </div>
      </header>

      <a class="scroll-cue" href="#projects" data-stage data-scroll-cue><span class="visually-hidden">Scroll to projects</span></a>
      <a class="scroll-cue-mobile" href="#projects" data-stage data-scroll-cue>
        <span class="visually-hidden">Scroll to projects</span>
        <svg aria-hidden="true" stroke="currentColor" width="43" height="15" viewBox="0 0 43 15"><path d="M1 1l20.5 12L42 1" stroke-width="2" fill="none" /></svg>
      </a>
    </section>

    <section class="projects" id="projects" aria-labelledby="projects-title">
      <h2 class="visually-hidden" id="projects-title">Projects</h2>
      {
        projects.map(({ slug, title, description, visual }, i) => (
          <article class="project" aria-labelledby={`project-${slug}`}>
            <div class="project-text">
              <span class="project-index">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="project-title" id={`project-${slug}`}>{title}</h3>
              <p class="project-description">{description}</p>
              <a class="button" href={`/projects/${slug}`}>
                View project<span class="visually-hidden">: {title}</span>
              </a>
            </div>
            <ProjectVisual visual={visual} />
          </article>
        ))
      }
    </section>

    <section class="experience" id="experience" aria-labelledby="experience-title">
      <div class="experience-head">
        <h2 class="section-title" id="experience-title">Experience</h2>
        <a class="button" href="/cv.pdf" download="Khang-Tran-CV.pdf">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24"><path d="M11 3h2v10.17l3.59-3.58L18 11l-6 6-6-6 1.41-1.41L11 13.17zM5 19h14v2H5z" /></svg>
          <span>Download CV</span>
        </a>
      </div>
      <ol class="experience-list">
        {
          experience.map(({ title, company, dates, highlights }, i) => (
            <li class="experience-role" data-current={i === 0 ? 'true' : undefined}>
              <p class="experience-dates">{dates}</p>
              <div class="experience-marker" aria-hidden="true"></div>
              <div class="experience-body">
                <h3>{title}</h3>
                <p class="experience-company">{company}</p>
                <ul>
                  {highlights.map(h => <li>{h}</li>)}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="about" id="about" aria-labelledby="about-title">
      <h2 class="section-title" id="about-title">About</h2>
      <div class="prose">
        {about.map(p => <p>{p}</p>)}
      </div>
    </section>
  </main>

  <footer class="contact" id="contact" aria-labelledby="contact-title">
    <h2 class="section-title" id="contact-title">Contact</h2>
    <p class="contact-pitch">{contactPitch}</p>
    <div class="contact-actions">
      <a class="button" href={email.href}>
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24"><path d={email.path} /></svg>
        <span>Send me an email</span>
      </a>
      <ul class="contact-links">
        {
          elsewhere.map(({ label, href, path }) => (
            <li>
              <a href={href} target="_blank" rel="noopener noreferrer">
                <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24"><path d={path} /></svg>
                <span>{label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <p class="contact-meta">© {new Date().getFullYear()} {name}</p>
  </footer>

  <script>
    import '../scripts/page';
  </script>
</Base>
