---
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/500.css';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/global.css';
import { name, nav, role, social } from '../data';

const { title, description } = Astro.props as { title: string; description: string };
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    {Astro.site && <meta property="og:image" content={new URL('/og.png', Astro.site).href} />}
    {Astro.site && <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // set before first paint so there is no theme flash, and so no-js visitors get the final state
      document.documentElement.classList.add('js');
      const theme = localStorage.getItem('theme');
      if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
    </script>
  </head>
  <body>
    <a class="button skip-link" href="#content">Skip to content</a>

    <header class="rail">
      <a class="monogram" href="/#intro" aria-label={`${name}, ${role} developer`}>
        <svg aria-hidden="true" class="mark" width="48" height="29" viewBox="0 0 48 29">
          <text x="0" y="22">kt<tspan class="mark-cursor">_</tspan></text>
        </svg>
      </a>
      <nav class="rail-nav" aria-label="Main">
        <div class="rail-links">
          {nav.map(label => <a class="rail-link" href={`/#${label.toLowerCase()}`} data-nav-link>{label}</a>)}
        </div>
        <div class="rail-icons">
          {
            social.map(({ label, href, path }) => (
              <a class="rail-icon" href={href} aria-label={label} target={href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">
                <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24"><path d={path} /></svg>
              </a>
            ))
          }
        </div>
      </nav>
    </header>

    <button class="theme-toggle" type="button" aria-label="Toggle theme" data-theme-toggle>
      <svg aria-hidden="true" width="38" height="38" viewBox="0 0 38 38">
        <defs>
          <mask id="theme-toggle-mask">
            <circle class="toggle-circle" data-mask="true" cx="19" cy="19" r="13"></circle>
            <circle class="toggle-mask" cx="25" cy="14" r="9"></circle>
          </mask>
        </defs>
        <path class="toggle-rays" d="M19 3v7M19 35v-7M32.856 11l-6.062 3.5M5.144 27l6.062-3.5M5.144 11l6.062 3.5M32.856 27l-6.062-3.5"></path>
        <circle class="toggle-circle" mask="url(#theme-toggle-mask)" cx="19" cy="19" r="12"></circle>
      </svg>
    </button>

    <button class="menu-toggle" type="button" aria-label="Menu" popovertarget="menu">
      <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24"><path class="menu-line" d="M4 9h16" /><path class="menu-line" d="M4 15h16" /></svg>
    </button>
    <nav class="menu" id="menu" popover aria-label="Main" data-nav-menu>
      <div class="menu-links">
        {nav.map(label => <a class="menu-link" href={`/#${label.toLowerCase()}`} data-nav-link>{label}</a>)}
      </div>
      <div class="menu-icons">
        {
          social.map(({ label, href, path }) => (
            <a class="rail-icon" href={href} aria-label={label} target={href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">
              <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24"><path d={path} /></svg>
            </a>
          ))
        }
      </div>
    </nav>

    <slot />

    <script>
      import '../scripts/theme';
      import '../scripts/nav';
    </script>
  </body>
</html>
